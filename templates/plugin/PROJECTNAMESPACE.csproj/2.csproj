<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Plugin.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Early-bound types generated by "Generate Earlybound" (pac modelbuilder) land in the
         component's generated/ folder, one level above this nested project — outside the SDK
         default *.cs glob, so include them explicitly. A missing folder matches zero files. -->
    <Compile Include="..\generated\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.45" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="9.0.2.45" />
    <PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.1.0.79" />
    <PackageReference Include="spkl" Version="1.0.640" />
  </ItemGroup>
</Project>