{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "outDir": "webresources",
    "rootDir": "webresources_src",
    "removeComments": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "pretty": true,
    "typeRoots": ["./typings", "./node_modules"],
    "types": ["@types/jest"]
  }
}
