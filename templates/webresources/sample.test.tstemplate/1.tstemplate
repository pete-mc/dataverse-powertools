import { ClassName } from "../ClassName";
import { XrmMockGenerator } from "xrm-mock";

describe("ClassName", () => {
  beforeEach(() => {
    // Fresh mock form context before each test.
    XrmMockGenerator.initialise();
    // Seed any attributes your logic reads, e.g.:
    XrmMockGenerator.Attribute.createString("name", "Contoso");
  });

  it("runs OnLoad without error", async () => {
    await ClassName.OnLoad(XrmMockGenerator.eventContext as unknown as Xrm.ExecutionContext<unknown, unknown>);

    const form = XrmMockGenerator.eventContext.getFormContext();
    // Assert against the resulting form state, e.g. the value your OnLoad logic set:
    expect(form.getAttribute("name").getValue()).toBe("Contoso");
  });
});
