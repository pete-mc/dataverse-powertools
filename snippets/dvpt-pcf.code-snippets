{
  "DVPT PCF service": {
    "prefix": "dvpt-service",
    "scope": "typescript,typescriptreact",
    "description": "PCF service layer — pure TS Dataverse/domain logic, no React or PCF types (unit-testable). Part of the dataverse-powertools service-layer PCF pattern.",
    "body": [
      "export interface ${1:Widget} {",
      "\tid: string;",
      "\tname: string;",
      "}",
      "",
      "/**",
      " * Service / domain layer: pure TypeScript, no React and no PCF lifecycle types,",
      " * so it can be unit-tested in isolation. Inject `ComponentFramework.WebApi` from",
      " * `index.ts` (context.webAPI) rather than reaching for a global.",
      " */",
      "export class ${1:Widget}Service {",
      "\tconstructor(private readonly webApi: ComponentFramework.WebApi) {}",
      "",
      "\tasync getAll(): Promise<${1:Widget}[]> {",
      "\t\tconst result = await this.webApi.retrieveMultipleRecords(\"${2:account}\", \"?$select=${3:name}\");",
      "\t\treturn result.entities.map((entity) => ({ id: entity.${4:accountid}, name: entity.${3:name} }));",
      "\t}",
      "}",
      ""
    ]
  },
  "DVPT PCF hook": {
    "prefix": "dvpt-hook",
    "scope": "typescript,typescriptreact",
    "description": "PCF binding hook — thin useXyz() that wires a service to component state. Part of the dataverse-powertools service-layer PCF pattern.",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "import { ${1:Widget}Service, ${1:Widget} } from \"../services/${1:Widget}Service\";",
      "",
      "/**",
      " * Binding layer: wires a service to React state. Keep it thin — no domain logic",
      " * here (that lives in the service) and no Fluent markup (that lives in the component).",
      " */",
      "export function use${1:Widget}s(service: ${1:Widget}Service): { items: ${1:Widget}[]; loading: boolean; error?: string } {",
      "\tconst [items, setItems] = useState<${1:Widget}[]>([]);",
      "\tconst [loading, setLoading] = useState(true);",
      "\tconst [error, setError] = useState<string | undefined>();",
      "",
      "\tuseEffect(() => {",
      "\t\tlet active = true;",
      "\t\tsetLoading(true);",
      "\t\tservice",
      "\t\t\t.getAll()",
      "\t\t\t.then((result) => {",
      "\t\t\t\tif (active) {",
      "\t\t\t\t\tsetItems(result);",
      "\t\t\t\t\tsetLoading(false);",
      "\t\t\t\t}",
      "\t\t\t})",
      "\t\t\t.catch((err) => {",
      "\t\t\t\tif (active) {",
      "\t\t\t\t\tsetError(err?.message ?? String(err));",
      "\t\t\t\t\tsetLoading(false);",
      "\t\t\t\t}",
      "\t\t\t});",
      "\t\treturn () => {",
      "\t\t\tactive = false;",
      "\t\t};",
      "\t}, [service]);",
      "",
      "\treturn { items, loading, error };",
      "}",
      ""
    ]
  },
  "DVPT PCF component": {
    "prefix": "dvpt-component",
    "scope": "typescriptreact",
    "description": "PCF presentational component — Fluent UI, no data access. Part of the dataverse-powertools service-layer PCF pattern.",
    "body": [
      "import * as React from \"react\";",
      "import { ${1:Widget} } from \"../services/${1:Widget}Service\";",
      "",
      "export interface ${1:Widget}ListProps {",
      "\titems: ${1:Widget}[];",
      "\tloading: boolean;",
      "\terror?: string;",
      "}",
      "",
      "/**",
      " * Presentational component: Fluent UI markup only, driven entirely by props —",
      " * no data access and no lifecycle. Feed it from a hook in `index.ts`.",
      " */",
      "export const ${1:Widget}List: React.FC<${1:Widget}ListProps> = ({ items, loading, error }) => {",
      "\tif (loading) {",
      "\t\treturn <div>Loading…</div>;",
      "\t}",
      "\tif (error) {",
      "\t\treturn <div role=\"alert\">{error}</div>;",
      "\t}",
      "\treturn (",
      "\t\t<ul>",
      "\t\t\t{items.map((item) => (",
      "\t\t\t\t<li key={item.id}>{item.name}</li>",
      "\t\t\t))}",
      "\t\t</ul>",
      "\t);",
      "};",
      ""
    ]
  }
}
