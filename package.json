{
  "name": "dataverse-powertools",
  "displayName": "Dataverse PowerTools",
  "description": "Tools to help build and manage Dataverse, CDS, Power Platform, PowerApps, and Dynamics 365 CE projects",
  "publisher": "dataversepowertools",
  "icon": "media/logo_new.png",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/pete-mc/dataverse-powertools"
  },
  "version": "0.14.27",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dataverse-powertools.readProject",
    "onCommand:dataverse-powertools.generateTemplate",
    "workspaceContains:**/dataverse-powertools.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/dvpt-pcf.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/dvpt-pcf.code-snippets"
      }
    ],
    "languageModelTools": [
      {
        "name": "dvpt_connectionStatus",
        "displayName": "Dataverse connection status",
        "modelDescription": "Get the current Dataverse PowerTools connection for this workspace: organization URL, auth type (service principal or interactive/OAuth), and whether a token has been acquired. Never returns secrets. Call this before other Dataverse tools to check readiness.",
        "toolReferenceName": "dvptConnectionStatus",
        "canBeReferencedInPrompt": true,
        "icon": "$(plug)",
        "tags": [
          "dataverse",
          "powertools"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "dvpt_listComponents",
        "displayName": "List Dataverse components",
        "modelDescription": "List the Dataverse PowerTools components discovered in this workspace (plugins, web resources, PCF controls, Azure Functions, solutions), with their type, name, and folder.",
        "toolReferenceName": "dvptListComponents",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "tags": [
          "dataverse",
          "powertools"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "dvpt_systemRequirements",
        "displayName": "Dataverse PowerTools requirements",
        "modelDescription": "Report whether the Dataverse PowerTools system requirements (dotnet, node, pac) are installed on this machine.",
        "toolReferenceName": "dvptSystemRequirements",
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "tags": [
          "dataverse",
          "powertools"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "dvpt_deploy",
        "displayName": "Build & deploy to Dataverse",
        "modelDescription": "Build and deploy the active Dataverse PowerTools component (plugin package / web resources) to the connected environment. Mutating: requires the 'readwrite' Copilot access mode and asks for confirmation before running.",
        "toolReferenceName": "dvptDeploy",
        "canBeReferencedInPrompt": true,
        "icon": "$(cloud-upload)",
        "tags": [
          "dataverse",
          "powertools",
          "deploy"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "dvpt_generateEarlybound",
        "displayName": "Generate early-bound classes",
        "modelDescription": "Generate early-bound C# entity classes for the active plugin component from the connected Dataverse environment. Mutating (writes files): requires the 'readwrite' Copilot access mode and asks for confirmation before running.",
        "toolReferenceName": "dvptGenerateEarlybound",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-class)",
        "tags": [
          "dataverse",
          "powertools"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dataverse-powertools.createWebResourceClass",
          "group": "navigation@9",
          "when": "dataverse-powertools.showLoaded && dataverse-powertools.isWebResource"
        },
        {
          "command": "dataverse-powertools.createWebResourceTest",
          "group": "navigation@10",
          "when": "dataverse-powertools.showLoaded && dataverse-powertools.isWebResource"
        },
        {
          "command": "dataverse-powertools.createPluginClass",
          "group": "navigation@9",
          "when": "dataverse-powertools.showLoaded && dataverse-powertools.isPlugin"
        },
        {
          "command": "dataverse-powertools.createWorkflowClass",
          "group": "navigation@10",
          "when": "dataverse-powertools.showLoaded && dataverse-powertools.isPlugin"
        },
        {
          "command": "dataverse-powertools.createPluginTest",
          "group": "navigation@11",
          "when": "dataverse-powertools.showLoaded && dataverse-powertools.isPlugin && dataverse-powertools.hasPluginUnitTesting"
        }
      ],
      "editor/context": [],
      "view/title": [
        {
          "command": "dataversePowerToolsTableIntersectTree.updateTree",
          "when": "view == dataversePowerToolsTableIntersectTree",
          "group": "navigation"
        },
        {
          "command": "dataversePowerToolsTableIntersectTree.addNewFormIntersect",
          "when": "view == dataversePowerToolsTableIntersectTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dataversePowerToolsTree.addEntry",
          "when": "view == dataversePowerToolsTree && viewItem == Available",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTree.deleteEntry",
          "when": "view == dataversePowerToolsTree && viewItem == Selected",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTree.manualAddToTree",
          "when": "view == dataversePowerToolsTree && viewItem == SelectedRoot",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTree.updateTree",
          "when": "view == dataversePowerToolsTree && viewItem == AvailableRoot",
          "group": "inline"
        },
        {
          "command": "dataverse-powertools.editModelBuilderSetting",
          "when": "view == dataversePowerToolsTree && (viewItem == ModelBuilderSetting || viewItem == ModelBuilderFilterItem)",
          "group": "inline"
        },
        {
          "command": "dataverse-powertools.configurePluginEarlyBound",
          "when": "view == dataversePowerToolsTree && viewItem == ModelBuilderConfigureAction",
          "group": "inline"
        },
        {
          "command": "dataverse-powertools.generateEarlyBound",
          "when": "view == dataversePowerToolsTree && viewItem == ModelBuilderGenerateAction",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTableIntersectTree.removeNewFormIntersect",
          "when": "view == dataversePowerToolsTableIntersectTree && viewItem == formintersect",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTableIntersectTree.addForm",
          "when": "view == dataversePowerToolsTableIntersectTree && viewItem == formintersect",
          "group": "inline"
        },
        {
          "command": "dataversePowerToolsTableIntersectTree.removeForm",
          "when": "view == dataversePowerToolsTableIntersectTree && viewItem == form",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataverse-powertools",
          "title": "Dataverse PowerTools",
          "icon": "media/logo_new.svg"
        }
      ]
    },
    "views": {
      "dataverse-powertools": [
        {
          "id": "dataversePowerToolsMenu",
          "name": "Actions",
          "icon": "media/dep.svg",
          "contextualTitle": "Dataverse PowerTools",
          "type": "webview"
        },
        {
          "id": "dataversePowerToolsTree",
          "name": "Earlybound Options",
          "icon": "media/dep.svg",
          "contextualTitle": "Package Explorer",
          "type": "tree",
          "when": "dataverse-powertools.earlyboundTreeLoaded"
        },
        {
          "id": "dataversePowerToolsTableIntersectTree",
          "name": "Form Intersects",
          "icon": "media/dep.svg",
          "contextualTitle": "Package Explorer",
          "type": "tree",
          "when": "dataverse-powertools.formIntersectTreeLoaded"
        }
      ],
      "explorer": []
    },
    "viewsWelcome": [
      {
        "view": "dataversePowerToolsTree",
        "contents": "Plugin early bound settings are not configured.\n[Configure Settings](command:dataverse-powertools.configurePluginEarlyBound)\n[Generate Early Bound](command:dataverse-powertools.generateEarlyBound)",
        "when": "dataverse-powertools.showLoaded && dataverse-powertools.isPlugin && dataverse-powertools.isPluginV3 && !dataverse-powertools.hasPluginModelBuilderSettings"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Dataverse PowerTools",
        "description": "Install the prerequisites, create a project from a template, connect to your environment and deploy.",
        "steps": [
          {
            "id": "requirements",
            "title": "Install the prerequisites",
            "description": "Dataverse PowerTools needs the .NET SDK, Node.js and the Power Platform CLI (pac) available on your PATH. The Actions panel shows what is missing.\n[Recheck Requirements](command:dataverse-powertools.recheckRequirements)",
            "media": {
              "markdown": "media/walkthrough/requirements.md"
            },
            "completionEvents": [
              "onContext:dataverse-powertools.hasPac"
            ]
          },
          {
            "id": "initialiseProject",
            "title": "Create your first project",
            "description": "Open an empty folder, then scaffold a Plugin, Web Resources, Solution or Portal project from a template.\n[Initialise Project](command:dataverse-powertools.initialiseProject)",
            "media": {
              "markdown": "media/walkthrough/initialise.md"
            },
            "completionEvents": [
              "onCommand:dataverse-powertools.initialiseProject",
              "onContext:dataverse-powertools.hasSupportedProjectType"
            ]
          },
          {
            "id": "connect",
            "title": "Connect to Dataverse",
            "description": "Connect with a service principal (client id + secret) or sign in interactively with your own account. Secrets are stored in VS Code secret storage, never in the project files.\n[Update Dataverse Authentication](command:dataverse-powertools.updateConnectionString)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:dataverse-powertools.showLoaded"
            ]
          },
          {
            "id": "buildDeploy",
            "title": "Build and deploy",
            "description": "Build your project and deploy it straight to your environment from the Actions panel.",
            "media": {
              "markdown": "media/walkthrough/deploy.md"
            },
            "completionEvents": [
              "onCommand:dataverse-powertools.buildAndDeploy",
              "onCommand:dataverse-powertools.deployWebresources",
              "onCommand:dataverse-powertools.deploySolution",
              "onCommand:dataverse-powertools.connectPortal"
            ]
          },
          {
            "id": "tour",
            "title": "Find your way around",
            "description": "The Dataverse PowerTools icon in the activity bar opens the Actions panel. Tests appear in the native Testing side bar, and classes/tests are created from the Explorer right-click menu.",
            "media": {
              "markdown": "media/walkthrough/tour.md"
            },
            "completionEvents": [
              "onView:dataversePowerToolsMenu"
            ]
          }
        ]
      }
    ],
